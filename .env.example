# cn-llmrouter — .env shape. The real .env is Kauket-managed:
#   kauket get kaiser.cn_llmrouter_env
# Mint the sidecar authkey (admin Mac):
#   ssh hs.gn.al 'docker exec cloudnet-headscale-1 headscale preauthkeys create --user 2 --tags tag:svc --expiration 1h'
# Comments must stay on their own lines (a trailing `# …` becomes part of the value).

# ── Tailscale + Headscale ──────────────────────────────────────────────────
LLMROUTER_AUTHKEY=
HEADSCALE_DOMAIN=hs.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1
# ── Domains (consul-register advertises llmrouter.<TAILNET_DOMAIN>:4000 under Host(llmrouter.<LAB_DOMAIN>)) ──
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al
# ── Step-CA root for the sidecar's trust store ────────────────────────────
PKI_IP=pki.lan
TIMEZONE=America/New_York

# ── Providers ──────────────────────────────────────────────────────────────
# Fireworks.ai account key (DeepSeek 4.1 Flash over the Anthropic-compatible endpoint)
FIREWORKS_AI_API_KEY=
# AWS Bedrock, us-east-2 — the same `wanfe` IAM user as aws.profile.bedrock / cn-librechat
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-2

# ── Local llama-servers (gear localllm, router mode, :8080) ───────────────
# LAN addresses are pfSense static leases on the Wi-Fi interface (cn-home
# LAN_STATIC_MAPPINGS): klaus .31, minerva .32, travelblock .33. Addresses,
# not names — inside the Tailscale netns `.lan` does not resolve.
QWEN_KLAUS_BASE=http://10.2.0.31:8080/v1
QWEN_MINERVA_BASE=http://10.2.0.32:8080/v1
QWEN_TRAVELBLOCK_BASE=http://10.2.0.33:8080/v1
# Tailnet addresses for the boxes that roam (minerva has no tailscale).
QWEN_KLAUS_TS_BASE=http://100.64.0.37:8080/v1
QWEN_TRAVELBLOCK_TS_BASE=http://100.64.0.44:8080/v1

# ── Amazon Nova developer API (api.nova.amazon.com; separate from Bedrock) ──
# Key minted at https://nova.amazon.com/dev → rows nova-2-lite, nova-pro, nova-lite, nova-micro.
AMAZON_NOVA_API_KEY=
